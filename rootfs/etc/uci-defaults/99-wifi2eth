#!/bin/sh
HOSTNAME='wifi2eth'
DEFAULT_PASSWORD='wifi2eth'

uci -q set system.@system[0].hostname="$HOSTNAME"
uci -q set wifi2eth.main='main'
uci -q set wifi2eth.main.mode='setup'
uci -q set wifi2eth.main.version='v1.2.0'
uci commit system
uci commit wifi2eth

# Default root password (the setup AP is intentionally open on first boot).
# Change immediately after first login: passwd
if command -v chpasswd >/dev/null 2>&1; then
  echo "root:$DEFAULT_PASSWORD" | chpasswd
else
  printf '%s\n%s\n' "$DEFAULT_PASSWORD" "$DEFAULT_PASSWORD" | passwd root >/dev/null 2>&1 || true
fi

i=0
while uci -q get dropbear.@dropbear[$i] >/dev/null 2>&1; do
  uci set dropbear.@dropbear[$i].PasswordAuth='on'
  uci set dropbear.@dropbear[$i].RootPasswordAuth='on'
  i=$((i + 1))
done
uci commit dropbear 2>/dev/null || true

WIFI2ETH_NO_RESTART=1 /usr/bin/wifi2eth setup-mode >/tmp/wifi2eth-firstboot.log 2>&1 || true
/etc/init.d/uhttpd enable 2>/dev/null || true
exit 0
