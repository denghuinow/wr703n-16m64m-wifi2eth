#!/bin/sh

MANAGEMENT_IP="192.168.77.1"
SETUP_SSID="WR703N-Setup"

usage() {
cat <<'USAGE'
WR703N-16M64M WiFi -> Ethernet

Usage:
  wifi2eth setup <SSID> <PASSWORD|-> [nat|relay] [none|psk2|sae|sae-mixed]
  wifi2eth setup-mode
  wifi2eth status

Examples:
  wifi2eth setup 'OfficeWiFi' 'secret123' nat psk2
  wifi2eth setup 'OfficeWiFi' 'secret123' relay psk2
  wifi2eth setup 'WPA3WiFi' 'secret123' nat sae
  wifi2eth setup 'OpenWiFi' - nat none

Modes:
  nat    Routed/NAT client. Stable default; Ethernet gets 192.168.77.x.
  relay  IPv4 relayd pseudo-bridge; Ethernet normally gets upstream DHCP.
USAGE
}

first_radio() {
  uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^=]*\)=wifi-device$/\1/p" | head -n1
}

find_zone() {
  want="$1"; i=0
  while :; do
    name="$(uci -q get firewall.@zone[$i].name)" || break
    [ "$name" = "$want" ] && { echo "@zone[$i]"; return 0; }
    i=$((i + 1))
  done
  return 1
}

remove_all_wifi_ifaces() {
  while uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1; do
    uci -q delete wireless.@wifi-iface[0]
  done
}

clear_setup_dns() {
  while uci -q get dhcp.@dnsmasq[0].address >/dev/null 2>&1; do
    uci -q delete dhcp.@dnsmasq[0].address
  done
}

set_dhcp_common() {
  uci -q set dhcp.lan='dhcp'
  uci set dhcp.lan.interface='lan'
  uci set dhcp.lan.start='100'
  uci set dhcp.lan.limit='100'
  uci set dhcp.lan.leasetime='12h'
  # Force DHCP even if eth0 sees another server (common when cable is plugged
  # into an upstream router). Without this, dnsmasq disables lan DHCP and
  # Wi-Fi clients on WR703N-Setup never get an address.
  uci set dhcp.lan.force='1'
  uci set dhcp.lan.ra='disabled'
  uci set dhcp.lan.dhcpv6='disabled'
  uci set dhcp.lan.ndp='disabled'
}

ensure_br_lan() {
  # Prefer an explicit bridge so AP (wlan) and eth0 share one L2 domain.
  # Using bare eth0 as lan.device often leaves the setup AP off the DHCP path.
  i=0
  while uci -q get network.@device[$i] >/dev/null 2>&1; do
    if [ "$(uci -q get network.@device[$i].name)" = "br-lan" ]; then
      uci -q delete network.@device[$i]
    else
      i=$((i + 1))
    fi
  done
  uci -q delete network.br_lan
  uci set network.br_lan='device'
  uci set network.br_lan.name='br-lan'
  uci set network.br_lan.type='bridge'
  uci -q delete network.br_lan.ports
  uci add_list network.br_lan.ports='eth0'
}

base_network() {
  uci -q delete network.wwan
  uci -q delete network.stabridge
  uci -q delete network.wan
  uci -q delete network.wan6

  ensure_br_lan
  uci set network.lan='interface'
  uci set network.lan.device='br-lan'
  uci set network.lan.proto='static'
  uci set network.lan.ipaddr="$MANAGEMENT_IP"
  uci set network.lan.netmask='255.255.255.0'
}

configure_sta() {
  ssid="$1"; pass="$2"; security="$3"
  radio="$(first_radio)"
  [ -n "$radio" ] || { echo "No wifi-device found" >&2; return 2; }

  remove_all_wifi_ifaces
  uci -q set wireless."$radio".disabled='0'
  iface="$(uci add wireless wifi-iface)"
  uci set wireless."$iface".device="$radio"
  uci set wireless."$iface".mode='sta'
  uci set wireless."$iface".network='wwan'
  uci set wireless."$iface".ssid="$ssid"
  uci set wireless."$iface".encryption="$security"

  case "$security" in
    none)
      uci -q delete wireless."$iface".key
      uci -q delete wireless."$iface".ieee80211w
      ;;
    sae)
      uci set wireless."$iface".key="$pass"
      uci set wireless."$iface".ieee80211w='2'
      ;;
    sae-mixed)
      uci set wireless."$iface".key="$pass"
      uci set wireless."$iface".ieee80211w='1'
      ;;
    *)
      uci set wireless."$iface".key="$pass"
      uci -q delete wireless."$iface".ieee80211w
      ;;
  esac
}

configure_setup_ap() {
  radio="$(first_radio)"
  [ -n "$radio" ] || { echo "No wifi-device found" >&2; return 2; }

  remove_all_wifi_ifaces
  uci -q set wireless."$radio".disabled='0'
  iface="$(uci add wireless wifi-iface)"
  uci set wireless."$iface".device="$radio"
  uci set wireless."$iface".mode='ap'
  uci set wireless."$iface".network='lan'
  uci set wireless."$iface".ssid="$SETUP_SSID"
  uci set wireless."$iface".encryption='none'
}

setup_firewall_portal() {
  lan_zone="$(find_zone lan 2>/dev/null || true)"
  wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then
    uci -q delete firewall."$lan_zone".network
    uci add_list firewall."$lan_zone".network='lan'
    uci set firewall."$lan_zone".input='ACCEPT'
    uci set firewall."$lan_zone".output='ACCEPT'
    uci set firewall."$lan_zone".forward='ACCEPT'
  fi
  if [ -n "$wan_zone" ]; then
    uci -q delete firewall."$wan_zone".network
  fi
}

setup_nat() {
  uci set network.wwan='interface'
  uci set network.wwan.proto='dhcp'
  uci -q delete network.stabridge
  set_dhcp_common
  uci set dhcp.lan.ignore='0'
  clear_setup_dns

  lan_zone="$(find_zone lan 2>/dev/null || true)"
  wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then
    uci -q delete firewall."$lan_zone".network
    uci add_list firewall."$lan_zone".network='lan'
    uci set firewall."$lan_zone".forward='ACCEPT'
  fi
  if [ -n "$wan_zone" ]; then
    uci -q delete firewall."$wan_zone".network
    uci add_list firewall."$wan_zone".network='wwan'
    uci set firewall."$wan_zone".input='REJECT'
    uci set firewall."$wan_zone".output='ACCEPT'
    uci set firewall."$wan_zone".forward='REJECT'
    uci set firewall."$wan_zone".masq='1'
    uci set firewall."$wan_zone".mtu_fix='1'
  fi
}

setup_relay() {
  uci set network.wwan='interface'
  uci set network.wwan.proto='dhcp'
  uci set network.stabridge='interface'
  uci set network.stabridge.proto='relay'
  uci set network.stabridge.network='lan wwan'
  set_dhcp_common
  uci set dhcp.lan.ignore='1'
  clear_setup_dns

  lan_zone="$(find_zone lan 2>/dev/null || true)"
  wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then
    uci -q delete firewall."$lan_zone".network
    uci add_list firewall."$lan_zone".network='lan'
    uci add_list firewall."$lan_zone".network='wwan'
    uci add_list firewall."$lan_zone".network='stabridge'
    uci set firewall."$lan_zone".input='ACCEPT'
    uci set firewall."$lan_zone".output='ACCEPT'
    uci set firewall."$lan_zone".forward='ACCEPT'
  fi
  if [ -n "$wan_zone" ]; then
    uci -q delete firewall."$wan_zone".network
  fi
}

setup_portal() {
  base_network
  set_dhcp_common
  uci set dhcp.lan.ignore='0'
  clear_setup_dns
  uci add_list dhcp.@dnsmasq[0].address="/#/$MANAGEMENT_IP"
  configure_setup_ap
  setup_firewall_portal
  uci -q set wifi2eth.main='main'
  uci set wifi2eth.main.mode='setup'
  uci -q delete wifi2eth.main.ssid
}

commit_all() {
  uci commit wireless
  uci commit network
  uci commit dhcp
  uci commit firewall
  uci commit wifi2eth 2>/dev/null || true
}

restart_all() {
  [ "${WIFI2ETH_NO_RESTART:-0}" = "1" ] && return 0
  /etc/init.d/network restart
  sleep 2
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  /etc/init.d/firewall restart 2>/dev/null || true
  /etc/init.d/uhttpd restart 2>/dev/null || true
}

validate_security() {
  pass="$1"; sec="$2"
  case "$sec" in
    none) return 0 ;;
    psk2|sae-mixed)
      [ ${#pass} -ge 8 ] && [ ${#pass} -le 63 ]
      ;;
    sae)
      [ ${#pass} -ge 1 ] && [ ${#pass} -le 63 ]
      ;;
    *) return 1 ;;
  esac
}

case "${1:-}" in
  setup)
    [ $# -ge 3 ] || { usage; exit 1; }
    SSID="$2"; PASS="$3"; MODE="${4:-nat}"; SECURITY="${5:-psk2}"
    [ -n "$SSID" ] || { echo "SSID must not be empty" >&2; exit 1; }
    [ ${#SSID} -le 32 ] || { echo "SSID is too long" >&2; exit 1; }
    case "$MODE" in nat|relay) ;; *) echo "Mode must be nat or relay" >&2; exit 1 ;; esac
    if [ "$PASS" = "-" ]; then PASS=""; SECURITY="none"; fi
    validate_security "$PASS" "$SECURITY" || { echo "Invalid password/security combination" >&2; exit 1; }

    base_network
    configure_sta "$SSID" "$PASS" "$SECURITY"
    if [ "$MODE" = "relay" ]; then setup_relay; else setup_nat; fi
    uci -q set wifi2eth.main='main'
    uci set wifi2eth.main.mode="$MODE"
    uci set wifi2eth.main.ssid="$SSID"
    uci set wifi2eth.main.security="$SECURITY"
    commit_all
    /etc/init.d/uhttpd enable 2>/dev/null || true
    restart_all
    echo "Configured: mode=$MODE security=$SECURITY ssid=$SSID"
    ;;

  setup-mode)
    setup_portal
    commit_all
    /etc/init.d/uhttpd enable 2>/dev/null || true
    restart_all
    echo "Setup mode enabled: $SETUP_SSID / http://$MANAGEMENT_IP/"
    ;;

  status)
    echo "mode=$(uci -q get wifi2eth.main.mode || echo unknown)"
    echo "ssid=$(uci -q get wifi2eth.main.ssid || true)"
    echo "security=$(uci -q get wifi2eth.main.security || true)"
    echo "--- wwan ---"
    ifstatus wwan 2>/dev/null || true
    echo "--- wireless ---"
    iwinfo 2>/dev/null || true
    ;;

  *) usage; exit 1 ;;
esac
