#!/bin/sh

MANAGEMENT_IP="192.168.77.1"
BOARD_NAME="$(ubus call system board 2>/dev/null | jsonfilter -e '@.board_name' 2>/dev/null || true)"
case "$BOARD_NAME" in
  phicomm,k2-v22.4|phicomm,k2-v22.5) SETUP_SSID="Phicomm-K2-Setup" ;;
  *) SETUP_SSID="WR703N-Setup" ;;
esac

usage() {
cat <<USAGE
WiFi -> Ethernet ($BOARD_NAME)

Usage:
  wifi2eth setup <SSID> <PASSWORD|-> [nat|relay] [none|psk2|sae|sae-mixed]
  wifi2eth setup-mode
  wifi2eth status

Modes:
  nat    Routed/NAT client. Stable default; Ethernet gets 192.168.77.x.
  relay  IPv4 relayd pseudo-bridge; Ethernet normally gets upstream DHCP.
USAGE
}

first_radio() {
  uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^=]*\)=wifi-device$/\1/p" | head -n1
}

lan_ports() {
  # Keep the board's OpenWrt-defined LAN topology. K2 has a switch and must not
  # be reduced to WR703N's single eth0 assumption.
  uci -q get network.@device[0].ports 2>/dev/null || true
}

find_zone() {
  want="$1"; i=0
  while :; do
    name="$(uci -q get firewall.@zone[$i].name)" || break
    [ "$name" = "$want" ] && { echo "@zone[$i]"; return 0; }
    i=$((i + 1))
  done
  return 1
}

remove_all_wifi_ifaces() {
  while uci -q get wireless.@wifi-iface[0] >/dev/null 2>&1; do uci -q delete wireless.@wifi-iface[0]; done
}

clear_setup_dns() {
  while uci -q get dhcp.@dnsmasq[0].address >/dev/null 2>&1; do uci -q delete dhcp.@dnsmasq[0].address; done
}

set_dhcp_common() {
  uci -q set dhcp.lan='dhcp'; uci set dhcp.lan.interface='lan'
  uci set dhcp.lan.start='100'; uci set dhcp.lan.limit='100'; uci set dhcp.lan.leasetime='12h'
  uci set dhcp.lan.force='1'; uci set dhcp.lan.ra='disabled'; uci set dhcp.lan.dhcpv6='disabled'; uci set dhcp.lan.ndp='disabled'
}

ensure_br_lan() {
  # Prefer the board-created br-lan. On WR703N create a one-port bridge when
  # needed; on K2 preserve the DSA/switch LAN port membership generated by OpenWrt.
  if uci -q get network.lan.device | grep -qx 'br-lan' && uci show network 2>/dev/null | grep -q "\.name='br-lan'"; then
    return 0
  fi
  i=0
  while uci -q get network.@device[$i] >/dev/null 2>&1; do
    [ "$(uci -q get network.@device[$i].name)" = "br-lan" ] && return 0
    i=$((i + 1))
  done
  uci -q delete network.br_lan
  uci set network.br_lan='device'; uci set network.br_lan.name='br-lan'; uci set network.br_lan.type='bridge'
  case "$BOARD_NAME" in
    phicomm,k2-*)
      # K2 defaults should already provide br-lan. Do not guess switch ports.
      ;;
    *) uci add_list network.br_lan.ports='eth0' ;;
  esac
}

base_network() {
  uci -q delete network.wwan; uci -q delete network.stabridge
  # Keep board-defined physical WAN/device sections; only WiFi WWAN is managed.
  ensure_br_lan
  uci set network.lan='interface'; uci set network.lan.device='br-lan'; uci set network.lan.proto='static'
  uci set network.lan.ipaddr="$MANAGEMENT_IP"; uci set network.lan.netmask='255.255.255.0'
}

configure_sta() {
  ssid="$1"; pass="$2"; security="$3"; radio="$(first_radio)"
  [ -n "$radio" ] || { echo "No wifi-device found" >&2; return 2; }
  remove_all_wifi_ifaces; uci -q set wireless."$radio".disabled='0'
  iface="$(uci add wireless wifi-iface)"
  uci set wireless."$iface".device="$radio"; uci set wireless."$iface".mode='sta'; uci set wireless."$iface".network='wwan'
  uci set wireless."$iface".ssid="$ssid"; uci set wireless."$iface".encryption="$security"
  case "$security" in
    none) uci -q delete wireless."$iface".key; uci -q delete wireless."$iface".ieee80211w ;;
    sae) uci set wireless."$iface".key="$pass"; uci set wireless."$iface".ieee80211w='2' ;;
    sae-mixed) uci set wireless."$iface".key="$pass"; uci set wireless."$iface".ieee80211w='1' ;;
    *) uci set wireless."$iface".key="$pass"; uci -q delete wireless."$iface".ieee80211w ;;
  esac
}

configure_setup_ap() {
  radio="$(first_radio)"; [ -n "$radio" ] || { echo "No wifi-device found" >&2; return 2; }
  remove_all_wifi_ifaces; uci -q set wireless."$radio".disabled='0'
  iface="$(uci add wireless wifi-iface)"
  uci set wireless."$iface".device="$radio"; uci set wireless."$iface".mode='ap'; uci set wireless."$iface".network='lan'
  uci set wireless."$iface".ssid="$SETUP_SSID"; uci set wireless."$iface".encryption='none'
}

setup_firewall_portal() {
  lan_zone="$(find_zone lan 2>/dev/null || true)"; wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then uci -q delete firewall."$lan_zone".network; uci add_list firewall."$lan_zone".network='lan'; uci set firewall."$lan_zone".input='ACCEPT'; uci set firewall."$lan_zone".output='ACCEPT'; uci set firewall."$lan_zone".forward='ACCEPT'; fi
  [ -n "$wan_zone" ] && uci -q delete firewall."$wan_zone".network
}

setup_nat() {
  uci set network.wwan='interface'; uci set network.wwan.proto='dhcp'; uci -q delete network.stabridge
  set_dhcp_common; uci set dhcp.lan.ignore='0'; clear_setup_dns
  lan_zone="$(find_zone lan 2>/dev/null || true)"; wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then uci -q delete firewall."$lan_zone".network; uci add_list firewall."$lan_zone".network='lan'; uci set firewall."$lan_zone".forward='ACCEPT'; fi
  if [ -n "$wan_zone" ]; then uci -q delete firewall."$wan_zone".network; uci add_list firewall."$wan_zone".network='wwan'; uci set firewall."$wan_zone".input='REJECT'; uci set firewall."$wan_zone".output='ACCEPT'; uci set firewall."$wan_zone".forward='REJECT'; uci set firewall."$wan_zone".masq='1'; uci set firewall."$wan_zone".mtu_fix='1'; fi
}

setup_relay() {
  uci set network.wwan='interface'; uci set network.wwan.proto='dhcp'; uci set network.stabridge='interface'; uci set network.stabridge.proto='relay'; uci set network.stabridge.network='lan wwan'
  set_dhcp_common; uci set dhcp.lan.ignore='1'; clear_setup_dns
  lan_zone="$(find_zone lan 2>/dev/null || true)"; wan_zone="$(find_zone wan 2>/dev/null || true)"
  if [ -n "$lan_zone" ]; then uci -q delete firewall."$lan_zone".network; uci add_list firewall."$lan_zone".network='lan'; uci add_list firewall."$lan_zone".network='wwan'; uci add_list firewall."$lan_zone".network='stabridge'; uci set firewall."$lan_zone".input='ACCEPT'; uci set firewall."$lan_zone".output='ACCEPT'; uci set firewall."$lan_zone".forward='ACCEPT'; fi
  [ -n "$wan_zone" ] && uci -q delete firewall."$wan_zone".network
}

setup_portal() { base_network; set_dhcp_common; uci set dhcp.lan.ignore='0'; clear_setup_dns; uci add_list dhcp.@dnsmasq[0].address="/#/$MANAGEMENT_IP"; configure_setup_ap; setup_firewall_portal; uci -q set wifi2eth.main='main'; uci set wifi2eth.main.mode='setup'; uci -q delete wifi2eth.main.ssid; }
commit_all() { uci commit wireless; uci commit network; uci commit dhcp; uci commit firewall; uci commit wifi2eth 2>/dev/null || true; }
reload_wireless() { ubus call network.wireless reconf >/dev/null 2>&1 && return 0; [ -x /sbin/wifi ] && { wifi reconf 2>/dev/null || wifi reload 2>/dev/null || wifi up 2>/dev/null || true; }; }
restart_all() { [ "${WIFI2ETH_NO_RESTART:-0}" = "1" ] && return 0; /etc/init.d/network restart; sleep 1; reload_wireless; sleep 2; /etc/init.d/dnsmasq restart 2>/dev/null || true; /etc/init.d/firewall restart 2>/dev/null || true; /etc/init.d/uhttpd restart 2>/dev/null || true; }
validate_security() { pass="$1"; sec="$2"; case "$sec" in none) return 0;; psk2|sae-mixed) [ ${#pass} -ge 8 ] && [ ${#pass} -le 63 ];; sae) [ ${#pass} -ge 1 ] && [ ${#pass} -le 63 ];; *) return 1;; esac; }

case "${1:-}" in
  setup)
    [ $# -ge 3 ] || { usage; exit 1; }; SSID="$2"; PASS="$3"; MODE="${4:-nat}"; SECURITY="${5:-psk2}"
    [ -n "$SSID" ] && [ ${#SSID} -le 32 ] || { echo "Invalid SSID" >&2; exit 1; }
    case "$MODE" in nat|relay) ;; *) echo "Mode must be nat or relay" >&2; exit 1;; esac
    [ "$PASS" = "-" ] && { PASS=""; SECURITY="none"; }
    validate_security "$PASS" "$SECURITY" || { echo "Invalid password/security combination" >&2; exit 1; }
    base_network; configure_sta "$SSID" "$PASS" "$SECURITY"; [ "$MODE" = relay ] && setup_relay || setup_nat
    uci -q set wifi2eth.main='main'; uci set wifi2eth.main.mode="$MODE"; uci set wifi2eth.main.ssid="$SSID"; uci set wifi2eth.main.security="$SECURITY"
    commit_all; /etc/init.d/uhttpd enable 2>/dev/null || true; restart_all; echo "Configured: board=$BOARD_NAME mode=$MODE security=$SECURITY ssid=$SSID"
    ;;
  setup-mode) setup_portal; commit_all; /etc/init.d/uhttpd enable 2>/dev/null || true; restart_all; echo "Setup mode enabled: $SETUP_SSID / http://$MANAGEMENT_IP/" ;;
  status) echo "board=$BOARD_NAME"; echo "mode=$(uci -q get wifi2eth.main.mode || echo unknown)"; echo "ssid=$(uci -q get wifi2eth.main.ssid || true)"; echo "security=$(uci -q get wifi2eth.main.security || true)"; echo "--- wwan ---"; ifstatus wwan 2>/dev/null || true; echo "--- wireless ---"; iwinfo 2>/dev/null || true ;;
  *) usage; exit 1 ;;
esac
